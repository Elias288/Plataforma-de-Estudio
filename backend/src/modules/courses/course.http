###
# LOGIN
###
# @name login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "admin@instituto.com",
  "password": "123456"
}

### 

@token = {{login.response.body.token}}

###
# Get Courses
###
GET http://localhost:3000/courses
Authorization: Bearer {{token}}

###
# Create Courses
###
POST http://localhost:3000/courses
Authorization: Bearer {{token}}
content-type: application/json

{
  "name": "Backend 1",
  "description": "Curso de backend con Node.js",
  "professorId": "fe700a22-7077-49d6-bf15-0d73e2748573",
  "studentsIds": []
}

###

@courseId=741e9f1b-138b-4dec-96cc-cd11bddc0494

###
# Get Course By Id
###
GET http://localhost:3000/courses/{{courseId}}
Authorization: Bearer {{token}}

###
# Add Task of Course
###
POST http://localhost:3000/courses/{{courseId}}/tasks
Authorization: Bearer {{token}}
content-type: application/json

{
  "title": "TP 1",
  "description": "API REST con Express",
  "dueDate": "2026-02-10T23:59:00.000Z"
}

###
# Get Tasks of course
###
GET http://localhost:3000/courses/{{courseId}}/tasks
Authorization: Bearer {{token}}