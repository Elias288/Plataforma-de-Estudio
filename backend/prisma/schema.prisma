generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String
  age            Int?
  gender         Gender?
  password       String
  role           Role
  createdAt      DateTime        @default(now())
  taughtCourses  Course[]        @relation("ProfessorCourses")
  courseStudents CourseStudent[]
  submissions    Submission[]
  courses        Course[]        @relation("StudentCourses")
}

model Course {
  id             String          @id @default(uuid())
  name           String          @unique
  description    String
  createdAt      DateTime        @default(now())
  professorId    String
  professor      User            @relation("ProfessorCourses", fields: [professorId], references: [id])
  courseStudents CourseStudent[]
  tasks          Task[]
  students       User[]          @relation("StudentCourses")
}

model CourseStudent {
  id        String @id @default(uuid())
  courseId  String
  studentId String
  course    Course @relation(fields: [courseId], references: [id])
  student   User   @relation(fields: [studentId], references: [id])

  @@unique([courseId, studentId])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  courseId    String
  submissions Submission[]
  course      Course       @relation(fields: [courseId], references: [id])
}

model Submission {
  id          String   @id @default(uuid())
  repoUrl     String
  description String
  grade       Int?
  createdAt   DateTime @default(now())
  feedback    String?
  taskId      String
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  task        Task     @relation(fields: [taskId], references: [id])

  @@unique([taskId, studentId])
}

enum Role {
  ADMIN
  PROFESOR
  ALUMNO
}

enum Gender {
  MALE
  FEMALE
}
